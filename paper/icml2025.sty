%% ICML 2025 LaTeX Style File (patched for arxiv_submission)
%% Removed \twocolumn call — layout is controlled in main.tex

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/03/02 ICML 2025 Conference Style]

% Package options
\newif\ifaccepted
\DeclareOption{accepted}{\acceptedtrue}
\DeclareOption*{\PackageWarning{icml2025}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

% Page layout
\RequirePackage[letterpaper,top=1in,bottom=1in,left=0.75in,right=0.75in,
               columnsep=0.25in]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage[numbers]{natbib}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{hyperref}

% Font settings
\RequirePackage[T1]{fontenc}
\RequirePackage{times}

% Section formatting
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.5ex \@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-2.0ex\@plus -1ex \@minus -.2ex}%
  {1.0ex \@plus .2ex}%
  {\normalsize\bfseries}}

\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex\@plus -1ex \@minus -.2ex}%
  {0.8ex \@plus .2ex}%
  {\normalsize\itshape}}

% Paragraph style for \paragraph{}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1ex \@plus .5ex \@minus .2ex}%
  {-1em}%
  {\normalsize\bfseries}}

% Abstract styling
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}\small}%
 {\end{quote}\vspace{1ex}}

% Hyperref configuration
\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  citecolor=blue,
  filecolor=blue,
  urlcolor=blue
}

% Page numbers
\pagestyle{plain}

% Tighter float spacing
\setlength{\floatsep}{6pt plus 2pt minus 2pt}
\setlength{\textfloatsep}{8pt plus 2pt minus 4pt}
\setlength{\intextsep}{6pt plus 2pt minus 2pt}
\setlength{\abovecaptionskip}{4pt}
\setlength{\belowcaptionskip}{2pt}

\endinput
